<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Exe on every platform, Windows included: subsretimer is a command-line
         tool first, and the headless auto mode has to reach a real stdout to
         print saved paths, which a WinExe does not have. The cost is a console
         window beside the editor when it is started from Explorer on Windows;
         subs2srs launches it with the console hidden. -->
    <OutputType>Exe</OutputType>
    <AssemblyName>subsretimer</AssemblyName>
    <RootNamespace>SubsRetimer</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>linux-x64;win-x64</RuntimeIdentifiers>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ApplicationIcon Condition="Exists('$(MSBuildProjectDirectory)/../assets/subsretimer.ico')">../assets/subsretimer.ico</ApplicationIcon>
    <Authors>Christopher Brochtrup;jhhr and contributors</Authors>
    <Copyright>Copyright © 2012 Christopher Brochtrup. © 2026 jhhr and contributors</Copyright>
    <Description>Re-time a subtitle file to match the timings of another subtitle file</Description>
    <PackageProjectUrl>https://github.com/jhhr/subsretimer</PackageProjectUrl>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <Version>0.1.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../SubsRetimer.Core/SubsRetimer.Core.csproj" />
    <ProjectReference Include="../SubsRetimer.Gtk/SubsRetimer.Gtk.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SubsRetimer.Tests" />
  </ItemGroup>
</Project>
